{
  "name": "ziaforge",
  "private": true,
  "version": "1.0.7",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js && node scripts/fix-node-pty-helper.cjs",
    "dev": "vite",
    "build": "node scripts/package-macos.cjs",
    "build:dev": "node scripts/package-macos.cjs",
    "package:mac": "node scripts/package-macos.cjs",
    "package:platform": "node scripts/platform/package.cjs",
    "package:source": "node scripts/platform/source.cjs",
    "qa:platform": "node scripts/platform/smoke.cjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "build:e2e": "tsc && vite build",
    "test:e2e": "npm run build:e2e && playwright test",
    "test:e2e:debug": "npm run build:e2e && playwright test --debug",
    "qa:doctor": "node scripts/qa/doctor.cjs",
    "qa:check": "node scripts/qa/check.cjs",
    "qa:inspect": "node scripts/qa/inspect.cjs",
    "qa:scale": "node scripts/qa/history-scale.cjs",
    "qa:package": "node scripts/mac/smoke.cjs",
    "preview": "vite preview",
    "ziaf": "node scripts/ziaf.cjs",
    "help:generate": "node scripts/help/generate.cjs",
    "help:check": "node scripts/help/generate.cjs --check",
    "qa:telegram": "node scripts/qa/telegram-live.cjs",
    "package:linux": "node scripts/linux/docker.cjs",
    "qa:linux": "node scripts/linux/docker.cjs smoke",
    "locales:check": "node scripts/locales/check.cjs",
    "locales:audit": "node scripts/locales/check.cjs --audit",
    "package:linux:prepare": "node scripts/linux/docker.cjs prepare"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "codemirror": "^6.0.2",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.24.0",
    "node-pty": "^1.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "semver": "^7.8.5",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "24.13.6",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "happy-dom": "^20.14.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.2.2",
    "vite": "8.3.0",
    "vite-plugin-electron": "1.1.2",
    "vite-plugin-electron-renderer": "1.0.0",
    "vitest": "^4.1.11"
  },
  "main": "dist-electron/main.js",
  "license": "Apache-2.0",
  "bin": {
    "ziaf": "scripts/ziaf.cjs"
  },
  "description": "Forge, don’t vibe. Plan-driven AI development and work with your own CLI subscriptions or API providers.",
  "author": "ZIAForge contributors",
  "homepage": "https://ziaforge.studio/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZIAForge/ZIAForge.git"
  },
  "bugs": {
    "url": "https://github.com/ZIAForge/ZIAForge/issues"
  }
}
